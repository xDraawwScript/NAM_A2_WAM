# Copier ce fichier en server/.env (jamais commité) et remplir les valeurs.

# Chaîne de connexion MongoDB Atlas (la même que le TP convient : la base est choisie par MONGODB_DB)
MONGODB_URI=mongodb+srv://DB_USER:DB_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=nam-presets

# Secret de signature des JWT : longue chaîne aléatoire, différente de celle du TP
JWT_SECRET=replace-with-a-long-random-secret

PORT=3000

# Origines autorisées à appeler l'API (Live Server), séparées par des virgules
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Créer le compte de démonstration demo@example.com / Demo1234! au démarrage
SEED_DEMO=true
